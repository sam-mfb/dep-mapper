    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [],
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@sample/backup-api": ["./packages/backup-api/src/index.ts"],
